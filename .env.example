# === ScorpiCore Environment Variables ===
# Copy this file to .env and fill in the values

# Database
DB_HOST=localhost
DB_USER=scorpicore
DB_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
DB_NAME=scorpicore

# Server
PORT=3000
NODE_ENV=production

# Admin credentials (REQUIRED - no defaults)
ADMIN_USER=admin
ADMIN_PASS=CHANGE_THIS_TO_A_STRONG_PASSWORD

# JWT Secret (REQUIRED - at least 32 characters, use: openssl rand -hex 32)
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING

# CORS allowed origins (comma-separated, use * only for development)
ALLOWED_ORIGIN=https://yourdomain.com

# Logging
LOG_LEVEL=info
