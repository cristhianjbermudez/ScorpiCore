{
  "name": "scorpicore",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.cjs",
    "dev:full": "concurrently \"vite\" \"node server/index.cjs\"",
    "build": "vite build",
    "preview": "vite preview --host",
    "start": "NODE_ENV=production node server/index.cjs",
    "db:setup": "mysql -u root -p < server/schema.sql",
    "db:seed": "node server/seed.cjs",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\"",
    "test": "node --test server/test-api.cjs"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "gsap": "^3.15.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.25.0",
    "multer": "^2.2.0",
    "mysql2": "^3.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "playwright": "^1.61.1",
    "postcss": "^8.4.33",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.1",
    "vite": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
